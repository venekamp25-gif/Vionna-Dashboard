# Vionna Dashboard - local development settings for the backend.
# Copy this file to backend/.env and fill in YOUR OWN values. Never commit .env.
#
# A second developer never needs the production values. Use a free Shopify
# development store plus a Dev Dashboard app, and an API key from the workspace
# the owner gives you. See CLAUDE.md, section "Working here as a second developer".

# Claude API key used by the dashboard itself for content generation.
# Ask the owner for a key from the dev workspace (it has its own spend limit).
ANTHROPIC_API_KEY=

# Shopify apps, created in the Shopify Partners Dev Dashboard (one per store).
# The app's redirect URL for local development must be:
#   http://localhost:5000/callback
# For local development point "dk" at YOUR development store. Leave fr/fi empty
# unless you also create development stores for them; features for a store
# without a domain are simply unavailable locally.
SHOPIFY_DK_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_DK_CLIENT_ID=
SHOPIFY_DK_CLIENT_SECRET=
SHOPIFY_FR_DOMAIN=
SHOPIFY_FR_CLIENT_ID=
SHOPIFY_FR_CLIENT_SECRET=
SHOPIFY_FI_DOMAIN=
SHOPIFY_FI_CLIENT_ID=
SHOPIFY_FI_CLIENT_SECRET=

# After starting the backend, connect the store once by opening
#   http://localhost:5000/auth/dk
# The token lands in backend/tokens.json (gitignored). Never copy the owner's
# tokens.json: those are the live tokens of the real shops.

# Optional: where /api/version looks for the newest released version.
# GITHUB_RAW=https://raw.githubusercontent.com/venekamp25-gif/Vionna-Dashboard/main

# Set automatically by start.bat. It disables the auth gate and the
# self-updater for local runs. NEVER set this on the droplet.
# DEV_LOCAL=1
