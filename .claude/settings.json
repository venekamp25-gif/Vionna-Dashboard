{
  "permissions": {
    "deny": [
      "Read(./backend/.env)",
      "Read(./backend/tokens.json)",
      "Read(./backend/lighting_tokens.json)",
      "Read(./backend/slack_config.json)",
      "Read(./frontend/.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}\"/scripts/secret-scan.py"
          }
        ]
      }
    ]
  }
}
